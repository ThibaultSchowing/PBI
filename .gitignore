# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# directories and notebook stuff
data/
*.csv
local_raw_data/

# Private data directory — the directory is tracked but its contents are gitignored.
# Place your private phage/host datasets here (one subdirectory per source).
# Exceptions: test_private/ and test_private_2/ are committed as worked examples.
private_data/*
!private_data/.gitkeep
!private_data/test_private/
!private_data/test_private/**
!private_data/test_private_2/
!private_data/test_private_2/**

# Pipeline logs/reports directory — the directory is tracked but generated files are gitignored.
# HTML reports and log files written by the pipeline container will appear here.
pipeline_logs/*
!pipeline_logs/.gitkeep

# Notebook durable analysis outputs (mounted to /results in analysis container).
outputs/*
!outputs/.keep
!outputs/export/
!outputs/export/.gitkeep
.ipynb_checkpoints
*/.ipynb_checkpoints/*
notebooks/exports/
notebooks/.cache/

