# NCBI credentials — required for host genome downloads
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Docker Compose reads .env automatically and passes these variables into
# the pipeline container. Never commit your .env file to version control.

# Your email address — required by NCBI Terms of Service
NCBI_EMAIL=your.email@example.com

# NCBI API key — optional but strongly recommended (10x faster downloads)
# Get a free key at https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# ── Non-root container execution ─────────────────────────────────────────────
# Set these so containers write files as your user (not root).
# Run the one-liner below once after copying this file:
#
#   echo "UID=$(id -u)" >> .env
#   echo "GID=$(id -g)" >> .env
#
# Default (1000:1000) is fine on most single-user Linux desktops.
# On macOS Docker Desktop file ownership is handled transparently —
# setting these values is still safe and has no negative effect.
UID=1000
GID=1000

# Optional override for private-data mount path inside containers.
# Default in docker-compose.yml: /private-data
PBI_PRIVATE_DATA_DIR=/private-data

# Optional output directory for notebook exports in the analysis container.
# Default in docker-compose.yml: /results
PBI_RESULTS_DIR=/results

# Optional: JupyterLab authentication token.
# Leave empty for no authentication (default, localhost only).
# When set, JupyterLab requires this token in the URL to access the UI.
# Example: JUPYTER_TOKEN=my-secret-token
JUPYTER_TOKEN=

# ── GPU support ────────────────────────────────────────────────────────────────
# The analysis container includes NVIDIA CUDA by default for GPU-accelerated
# ML training. To use GPU, you must install the NVIDIA Container Toolkit
# on the host machine:
#
#   curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | \
#     sudo gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
#   curl -s -L https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list | \
#     sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' | \
#     sudo tee /etc/apt/sources.list.d/nvidia-container-toolkit.list
#   sudo apt-get update && sudo apt-get install -y nvidia-container-toolkit
#   sudo nvidia-ctk runtime configure --runtime=docker
#   sudo systemctl restart docker
#
# Verify GPU access:
#   docker run --rm --gpus all nvidia/cuda:12.4.1-base-ubuntu22.04 nvidia-smi
#
# To disable GPU (run on CPU only), comment out the deploy.resources block
# in docker-compose.yml or set this variable:
# NVIDIA_VISIBLE_DEVICES=""
